c:["$","$Le",null,{"tasks":[{"slug":"vllm-anthropic-inline-system-template","name":"ai-infra-bench/vllm-anthropic-inline-system-template","version":"1.0.0","description":"Fix inline system-message handling in Anthropic Messages and token-counting requests.","keywords":["vllm","anthropic","chat-template","token-counting"],"domain":"inference","taskType":"bugfix","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]},{"slug":"vllm-asr-chunk-spacing","name":"ai-infra-bench/vllm-asr-chunk-spacing","version":"1.0.0","description":"Preserve word boundaries when merging multi-chunk ASR output.","keywords":["vllm","asr","transcription","streaming"],"domain":"inference","taskType":"bugfix","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]},{"slug":"vllm-async-kv-token-accounting","name":"ai-infra-bench/vllm-async-kv-token-accounting","version":"1.0.0","description":"Correct computed-token accounting when requests resume after asynchronous KV transfers.","keywords":["vllm","scheduler","kv-transfer","token-accounting"],"domain":"inference","taskType":"bugfix","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]},{"slug":"vllm-async-pp-token-handoff","name":"ai-infra-bench/vllm-async-pp-token-handoff","version":"1.0.0","description":"Add asynchronous scheduling for pipeline-parallel decoding with direct GPU token handoff.","keywords":["vllm","pipeline-parallel","nccl","async-scheduling"],"domain":"inference","taskType":"feature","repository":"vllm-project/vllm","gpus":2,"gpuTypes":["A100"]},{"slug":"vllm-async-spec-placeholder-discard","name":"ai-infra-bench/vllm-async-spec-placeholder-discard","version":"1.0.0","description":"Prevent scheduler crashes during prefix-cache resets with asynchronous speculative decoding.","keywords":["vllm","async-scheduling","speculative-decoding","prefix-cache"],"domain":"inference","taskType":"bugfix","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]},{"slug":"vllm-concurrent-config-refresh","name":"ai-infra-bench/vllm-concurrent-config-refresh","version":"1.0.0","description":"Fix intermittent model-configuration read failures during concurrent API server startup.","keywords":["vllm","configuration","concurrency"],"domain":"inference","taskType":"bugfix","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]},{"slug":"vllm-cpu-offload-reset-inflight","name":"ai-infra-bench/vllm-cpu-offload-reset-inflight","version":"1.0.0","description":"Support CPU-offload cache resets that safely handle in-flight transfers.","keywords":["vllm","kv-offload","prefix-cache","concurrency"],"domain":"inference","taskType":"feature","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]},{"slug":"vllm-deterministic-bmm-batch-scaling","name":"ai-infra-bench/vllm-deterministic-bmm-batch-scaling","version":"1.0.0","description":"Improve deterministic batched matrix multiplication performance as batch size grows.","keywords":["vllm","triton","bmm","determinism"],"domain":"inference","taskType":"performance","repository":"vllm-project/vllm","gpus":1,"gpuTypes":["A100"]},{"slug":"vllm-dp-multi-port-supervisor","name":"ai-infra-bench/vllm-dp-multi-port-supervisor","version":"1.0.0","description":"Add coordinated startup, health checks, and shutdown for data-parallel API servers on separate ports.","keywords":["vllm","data-parallel","supervisor","health-check"],"domain":"inference","taskType":"feature","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]},{"slug":"vllm-fused-moe-config-lifecycle","name":"ai-infra-bench/vllm-fused-moe-config-lifecycle","version":"1.0.0","description":"Preserve layer configuration through fused-MoE profiling and execution without spurious warnings.","keywords":["vllm","moe","parallel-config","profiling"],"domain":"inference","taskType":"bugfix","repository":"vllm-project/vllm","gpus":1,"gpuTypes":["A100"]},{"slug":"vllm-implement-anthropic-rust-serving","name":"ai-infra-bench/vllm-implement-anthropic-rust-serving","version":"1.0.0","description":"Support Anthropic Messages and token counting in the Rust frontend.","keywords":["vllm","rust","anthropic","serving-api"],"domain":"inference","taskType":"feature","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]},{"slug":"vllm-kv-admission-thrashing","name":"ai-infra-bench/vllm-kv-admission-thrashing","version":"1.0.0","description":"Prevent repeated preemption from starving long prompts and active decoding under KV-cache pressure.","keywords":["vllm","scheduler","kv-cache","preemption"],"domain":"inference","taskType":"bugfix","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]},{"slug":"vllm-kv-connector-lifecycle","name":"ai-infra-bench/vllm-kv-connector-lifecycle","version":"1.0.0","description":"Reject legacy KV connector constructors while preserving current plugin initialization and shutdown.","keywords":["vllm","kv-connector","api-compatibility","lifecycle"],"domain":"inference","taskType":"bugfix","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]},{"slug":"vllm-minimax-m3-streaming-reasoning","name":"ai-infra-bench/vllm-minimax-m3-streaming-reasoning","version":"1.0.0","description":"Correct MiniMax M3 streaming reasoning and tool calls across thinking modes.","keywords":["vllm","minimax-m3","reasoning","streaming"],"domain":"inference","taskType":"bugfix","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]},{"slug":"vllm-modular-moe-config-ownership","name":"ai-infra-bench/vllm-modular-moe-config-ownership","version":"1.0.0","description":"Keep modular MoE kernels using their own layer's configuration across context changes.","keywords":["vllm","moe","parallel-config","triton"],"domain":"inference","taskType":"bugfix","repository":"vllm-project/vllm","gpus":1,"gpuTypes":["A100"]},{"slug":"vllm-moe-permute-batch-scaling","name":"ai-infra-bench/vllm-moe-permute-batch-scaling","version":"1.0.0","description":"Improve native MoE permutation latency at larger batch sizes while preserving routing results.","keywords":["vllm","cuda","moe","token-routing"],"domain":"inference","taskType":"performance","repository":"vllm-project/vllm","gpus":1,"gpuTypes":["A100"]},{"slug":"vllm-mooncake-eagle-load-mask","name":"ai-infra-bench/vllm-mooncake-eagle-load-mask","version":"1.0.0","description":"Fix response corruption when Mooncake prefixes are reused across replicas with Eagle-3 enabled.","keywords":["vllm","mooncake","kv-transfer","speculative-decoding"],"domain":"inference","taskType":"bugfix","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]},{"slug":"vllm-mooncake-hybrid-pd-layout","name":"ai-infra-bench/vllm-mooncake-hybrid-pd-layout","version":"1.0.0","description":"Support hybrid GDN and padded MLA cache layouts in Mooncake prefill/decode transfers.","keywords":["vllm","mooncake","kv-transfer","hybrid-attention"],"domain":"inference","taskType":"feature","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]},{"slug":"vllm-multimodal-encoder-cache-accounting","name":"ai-infra-bench/vllm-multimodal-encoder-cache-accounting","version":"1.0.0","description":"Correct multimodal encoder-cache accounting and scheduling when prompt positions differ from embedding rows.","keywords":["vllm","multimodal","encoder-cache","scheduler"],"domain":"inference","taskType":"bugfix","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]},{"slug":"vllm-multimodal-merge-memory","name":"ai-infra-bench/vllm-multimodal-merge-memory","version":"1.0.0","description":"Reduce temporary GPU memory use when merging multimodal embeddings.","keywords":["vllm","multimodal","embeddings","memory"],"domain":"inference","taskType":"performance","repository":"vllm-project/vllm","gpus":1,"gpuTypes":["A100"]},{"slug":"vllm-persistent-kv-layout-namespace","name":"ai-infra-bench/vllm-persistent-kv-layout-namespace","version":"1.0.0","description":"Prevent response corruption when persistent KV caches are reused after switching model runners.","keywords":["vllm","kv-offload","persistent-cache","cache-layout"],"domain":"inference","taskType":"bugfix","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]},{"slug":"vllm-pyav-target-frame-selection","name":"ai-infra-bench/vllm-pyav-target-frame-selection","version":"1.0.0","description":"Fix incorrect frame selection in the PyAV video backend.","keywords":["vllm","multimodal","video","pyav"],"domain":"inference","taskType":"bugfix","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]},{"slug":"vllm-ray-zero-copy-logprobs","name":"ai-infra-bench/vllm-ray-zero-copy-logprobs","version":"1.0.0","description":"Prevent multi-node Ray serving from timing out after returning completions with log probabilities.","keywords":["vllm","ray","logprobs","shared-memory"],"domain":"inference","taskType":"bugfix","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]},{"slug":"vllm-remote-kv-idle-overhead","name":"ai-infra-bench/vllm-remote-kv-idle-overhead","version":"1.0.0","description":"Reduce idle scheduler overhead during asynchronous remote KV transfers while preserving request progress.","keywords":["vllm","scheduler","kv-transfer","async-scheduling"],"domain":"inference","taskType":"performance","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]},{"slug":"vllm-request-lifecycle-leak","name":"ai-infra-bench/vllm-request-lifecycle-leak","version":"1.0.0","description":"Fix memory retained by completed multimodal requests while preserving prefix-cache reuse.","keywords":["vllm","memory-leak","prefix-cache","multimodal"],"domain":"inference","taskType":"bugfix","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]},{"slug":"vllm-responses-compound-tool-deltas","name":"ai-infra-bench/vllm-responses-compound-tool-deltas","version":"1.0.0","description":"Fix truncated or missing tool calls in streamed Responses API output.","keywords":["vllm","responses-api","streaming","tool-calls"],"domain":"inference","taskType":"bugfix","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]},{"slug":"vllm-runner-v2-selection","name":"ai-infra-bench/vllm-runner-v2-selection","version":"1.0.0","description":"Enable automatic Model Runner V2 selection for supported Qwen3 models while honoring explicit overrides.","keywords":["vllm","model-runner","configuration"],"domain":"inference","taskType":"feature","repository":"vllm-project/vllm","gpus":1,"gpuTypes":["A100"]},{"slug":"vllm-rust-tool-entity-preservation","name":"ai-infra-bench/vllm-rust-tool-entity-preservation","version":"1.0.0","description":"Preserve literal entity text in Rust XML-style tool-call argument values.","keywords":["vllm","rust","tool-parser","xml"],"domain":"inference","taskType":"bugfix","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]},{"slug":"vllm-streaming-session-continuation","name":"ai-infra-bench/vllm-streaming-session-continuation","version":"1.0.0","description":"Add streaming input sessions that accept new chunks during generation without losing or duplicating tokens.","keywords":["vllm","streaming-input","request-lifecycle","async-generation"],"domain":"inference","taskType":"feature","repository":"vllm-project/vllm","gpus":1,"gpuTypes":["A100"]},{"slug":"vllm-tokenizer-pickle-threadpool","name":"ai-infra-bench/vllm-tokenizer-pickle-threadpool","version":"1.0.0","description":"Fix tokenizer failures when a prompt gateway dispatches work to Ray workers.","keywords":["vllm","tokenizer","pickle","thread-pool"],"domain":"inference","taskType":"bugfix","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]}]}]
