</span><span style=\"color:#686D67\">):</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">    \"\"\"Release only task-owned workload/observation records after completion.\"\"\"</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    pair</span><span style=\"color:#686D67\">.</span><span style=\"color:#303638\">workloads</span><span style=\"color:#686D67\">.</span><span style=\"color:#303638\">clear</span><span style=\"color:#686D67\">()</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    pair</span><span style=\"color:#686D67\">.</span><span style=\"color:#303638\">consumed</span><span style=\"color:#686D67\">.</span><span style=\"color:#303638\">clear</span><span style=\"color:#686D67\">()</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    pair</span><span style=\"color:#686D67\">.</span><span style=\"color:#303638\">delivered</span><span style=\"color:#686D67\">.</span><span style=\"color:#303638\">clear</span><span style=\"color:#686D67\">()</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    pair</span><span style=\"color:#686D67\">.</span><span style=\"color:#303638\">draft_delivered</span><span style=\"color:#686D67\">.</span><span style=\"color:#303638\">clear</span><span style=\"color:#686D67\">()</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    pair</span><span style=\"color:#686D67\">.</span><span style=\"color:#303638\">trace</span><span style=\"color:#686D67\">.</span><span style=\"color:#303638\">clear</span><span style=\"color:#686D67\">()</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    pair</span><span style=\"color:#686D67\">.</span><span style=\"color:#303638\">model</span><span style=\"color:#686D67\">.</span><span style=\"color:#303638\">encodings</span><span style=\"color:#686D67\">.</span><span style=\"color:#303638\">clear</span><span style=\"color:#686D67\">()</span></span>\n<span class=\"line\"><span style=\"color:#3