{"highlightedHtml":"<pre class=\"shiki ai-infra-paper\" style=\"background-color:#F8F7F3;color:#303638\"><code><span class=\"line\"><span style=\"color:#686D67;font-style:italic\">#!/usr/bin/env bash</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">set</span><span style=\"color:#8D4B43\"> -euo</span><span style=\"color:#8D4B43\"> pipefail</span></span>\n<span class=\"line\"><span style=\"color:#686D67;font-style:italic\"># Keep rewards protected and readable by a non-root Harbor host.</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">test</span><span style=\"color:#8D4B43\"> !</span><span style=\"color:#8D4B43\"> -L</span><span style=\"color:#8D4B43\"> /logs/verifier</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">install</span><span style=\"color:#8D4B43\"> -d</span><span style=\"color:#8D4B43\"> -m</span><span style=\"color:#2D6F7A\"> 755</span><span style=\"color:#8D4B43\"> /logs/verifier</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">chown</span><span style=\"color:#8D4B43\"> 0:0</span><span style=\"color:#8D4B43\"> /logs/verifier</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">rm</span><span style=\"color:#8D4B43\"> -f</span><span style=\"color:#8D4B43\"> /logs/verifier/reward.txt</span><span style=\"color:#8D4B43\"> /logs/verifier/verification.json</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">printf</span><span style=\"color:#8D4B43\"> '0\\n'</span><span style=\"color:#3F6D55\"> ></span><span style=\"color:#8D4B43\"> /logs/verifier/reward.txt</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">chmod</span><span style=\"color:#2D6F7A\"> 644</span><span style=\"color:#8D4B43\"> /logs/verifier/reward.txt</span></span>\n<span class=\"line\"><span style=\"color:#303638\">report</span><span style=\"color:#3F6D55\">=</span><span style=\"color:#8D4B43\">\"</span><span style=\"color:#686D67\">$(</span><span style=\"color:#806D1A\">mktemp</span><span style=\"color:#8D4B43\"> /logs/verifier/.verification.XXXXXX</span><span style=\"color:#686D67\">)</span><span style=\"color:#8D4B43\">\"</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">if</span><span style=\"color:#806D1A\"> cd</span><span style=\"color:#8D4B43\"> /workspace/vllm</span><span style=\"color:#686D67\"> &#x26;&#x26;</span><span style=\"color:#806D1A\"> python3</span><span style=\"color:#8D4B43\"> -I</span><span style=\"color:#8D4B43\"> -S</span><span style=\"color:#8D4B43\"> /tests/trusted_python.py</span><span style=\"color:#8D4B43\"> /tests/verify_encoder_cache.py</span><span style=\"color:#3F6D55\"> ></span><span style=\"color:#8D4B43\"> \"</span><span style=\"color:#686D67\">$</span><span style=\"color:#8D4B43\">report\"</span><span style=\"color:#3F6D55\"> 2>&#x26;1</span><span style=\"color:#686D67\">;</span><span style=\"color:#3F6D55\"> then</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">  printf</span><span style=\"color:#8D4B43\"> '1\\n'</span><span style=\"color:#3F6D55\"> ></span><span style=\"color:#8D4B43\"> /logs/verifier/reward.txt</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">fi</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">chmod</span><span style=\"color:#2D6F7A\"> 644</span><span style=\"color:#8D4B43\"> \"</span><span style=\"color:#686D67\">$</span><span style=\"color:#8D4B43\">report\"</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">mv</span><span style=\"color:#8D4B43\"> -f</span><span style=\"color:#8D4B43\"> \"</span><span style=\"color:#686D67\">$</span><span style=\"color:#8D4B43\">report\"</span><span style=\"color:#8D4B43\"> /logs/verifier/verification.json</span></span></code></pre>","lineCount":15}
