xisting allocations are reclaimed. Do</span></span>\n<span class=\"line\"><span style=\"color:#686D67;font-style:italic\">    # not clamp them: the per-run subtraction must retain that information.</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">    if</span><span style=\"color:#806D1A\"> any</span><span style=\"color:#686D67\">(</span><span style=\"color:#6E5C8A\">type</span><span style=\"color:#686D67\">(</span><span style=\"color:#303638\">value</span><span style=\"color:#686D67\">)</span><span style=\"color:#3F6D55\"> is</span><span style=\"color:#3F6D55\"> not</span><span style=\"color:#6E5C8A\"> int</span><span style=\"color:#3F6D55\"> for</span><span style=\"color:#303638\"> value </span><span style=\"color:#3F6D55\">in</span><span style=\"color:#303638\"> values</span><span style=\"color:#686D67\">):</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">        raise</span><span style=\"color:#6E5C8A\"> ValueError</span><span style=\"color:#686D67\">(</span><span style=\"color:#8D4B43\">'host allocation changes must be integer bytes'</span><span style=\"color:#686D67\">)</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    growth </span><span style=\"color:#3F6D55\">=</span><span style=\"color:#686D67\"> [[[</span><span style=\"color:#303638\">value </span><span style=\"color:#3F6D55\">-</span><span style=\"color:#303638\"> curve</span><span style=\"color:#686D67\">[</span><span style=\"color:#2D6F7A\">0</span><span style=\"color:#686D67\">]</span><span style=\"color:#3F6D55\"> for</span><span style=\"color:#303638\"> value </span><span style=\"color:#3F6D55\">in</span><span style=\"color:#303638\"> curve</span><span style=\"color:#686D67\">]</span><span style=\"color:#3F6D55\"> for</span><span style=\"color:#303638\"> curve </span><span style=\"color:#3F6D55\">in</span><span style=\"color:#303638\"> width</span><span style=\"color:#686D67\">]</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">   