{"highlightedHtml":"<pre class=\"shiki ai-infra-paper\" style=\"background-color:#F8F7F3;color:#303638\"><code><span class=\"line\"><span style=\"color:#686D67;font-style:italic\">#!/usr/bin/env bash</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">set</span><span style=\"color:#8D4B43\"> -euo</span><span style=\"color:#8D4B43\"> pipefail</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">[</span><span style=\"color:#8D4B43\"> \"</span><span style=\"color:#686D67\">$(</span><span style=\"color:#806D1A\">id</span><span style=\"color:#8D4B43\"> -u</span><span style=\"color:#686D67\">)</span><span style=\"color:#8D4B43\">\"</span><span style=\"color:#3F6D55\"> -eq</span><span style=\"color:#2D6F7A\"> 0</span><span style=\"color:#686D67\"> ]</span><span style=\"color:#3F6D55\"> ||</span><span style=\"color:#686D67\"> {</span><span style=\"color:#806D1A\"> echo</span><span style=\"color:#8D4B43\"> 'verifier setup must run as root'</span><span style=\"color:#3F6D55\"> >&#x26;2</span><span style=\"color:#686D67\">;</span><span style=\"color:#806D1A\"> exit</span><span style=\"color:#2D6F7A\"> 1</span><span style=\"color:#686D67\">;</span><span style=\"color:#686D67\"> }</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">mkdir</span><span style=\"color:#8D4B43\"> -p</span><span style=\"color:#8D4B43\"> /logs/verifier</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">printf</span><span style=\"color:#8D4B43\"> '0\\n'</span><span style=\"color:#3F6D55\"> ></span><span style=\"color:#8D4B43\"> /logs/verifier/reward.txt</span></span>\n<span class=\"line\"><span style=\"color:#303638\">python_bin</span><span style=\"color:#3F6D55\">=</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">for</span><span style=\"color:#303638\"> candidate </span><span style=\"color:#3F6D55\">in</span><span style=\"color:#8D4B43\"> /opt/venv/bin/python</span><span style=\"color:#8D4B43\"> /usr/local/bin/python</span><span st