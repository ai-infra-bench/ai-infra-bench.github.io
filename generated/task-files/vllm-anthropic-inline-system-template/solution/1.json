{"highlightedHtml":"<pre class=\"shiki ai-infra-paper\" style=\"background-color:#F8F7F3;color:#303638\"><code><span class=\"line\"><span style=\"color:#6E5C8A\">diff --git a/vllm/renderers/hf.py b/vllm/renderers/hf.py</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">---</span><span style=\"color:#6E5C8A\"> a/vllm/renderers/hf.py</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+++</span><span style=\"color:#6E5C8A\"> b/vllm/renderers/hf.py</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">@@</span><span style=\"color:#303638\"> -736,23 +736,62 </span><span style=\"color:#686D67\">@@</span></span>\n<span class=\"line\"><span style=\"color:#303638\">     if tokenize and \"return_dict\" not in resolved_kwargs:</span></span>\n<span class=\"line\"><span style=\"color:#303638\">         resolved_kwargs[\"return_dict\"] = False</span></span>\n<span class=\"line\"><span style=\"color:#303638\"> </span></span>\n<span class=\"line\"><span style=\"color:#686D67\">-</span><span style=\"color:#8D4B43\">    try:</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">    def is_text_only(content: object) -> bool:</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">        if isinstance(content, str):</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">            return True</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">        if not isinstance(content, list):</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">            return False</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">        return all(</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">            isinstance(part, str)</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">            or (</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">                isinstance(part, dict)</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">                and part.get(\"type\") == \"text\"</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">                and isinstance(part.get(\"text\"), str)</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">            )</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">            for part in content</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">        )</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">    def apply_chat_template(</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">        messages: list[ConversationMessage],</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">    ) -> str | list[int]:</span></span>\n<span class=\"line\"><span style=\"color:#303638\">         return tokenizer.apply_chat_template(</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">-</span><span style=\"color:#8D4B43\">            conversation=conversation,  # type: ignore[arg-type]</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">            conversation=messages,  # type: ignore[arg-type]</span></span>\n<span class=\"line\"><span style=\"color:#303638\">             tools=tools,  # type: ignore[arg-type]</span></span>\n<span class=\"line\"><span style=\"color:#303638\">             chat_template=chat_template,</span></span>\n<span class=\"line\"><span style=\"color:#303638\">             tokenize=tokenize,</span></span>\n<span class=\"line\"><span style=\"color:#303638\">             **resolved_kwargs,</span></span>\n<span class=\"line\"><span style=\"color:#303638\">         )</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">-</span><span style=\"color:#8D4B43\">    # External library exceptions can sometimes occur despite the framework's</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">-</span><span style=\"color:#8D4B43\">    # internal exception management capabilities.</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">-</span><span style=\"color:#8D4B43\">    except Exception as e:</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">-</span><span style=\"color:#8D4B43\">        # Log and report any library-related exceptions for further</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">-</span><span style=\"color:#8D4B43\">        # investigation.</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">    try:</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">        return apply_chat_template(conversation)</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">    except Exception as error:</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">        # Render with the real tokenizer/template context first. A compatible</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">        # template must keep its existing conversation layout. Only text-only</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">        # system messages can be consolidated without discarding content.</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">        has_inline_system = any(</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">            message[\"role\"] == \"system\" for message in conversation[1:]</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">        )</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">        text_only_system = all(</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">            is_text_only(message.get(\"content\", \"\"))</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">            for message in conversation</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">            if message[\"role\"] == \"system\"</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">        )</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">        if (</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">            isinstance(error, jinja2.TemplateError)</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">            and has_inline_system</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">            and text_only_system</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">        ):</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">            normalized = _consolidate_system_messages(conversation)</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">            try:</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">                return apply_chat_template(normalized)</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">            except Exception as retry_error:</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">                logger.exception(\"Chat template rejected the normalized conversation\")</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">                raise ValueError(str(retry_error)) from retry_error</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span></span>\n<span class=\"line\"><span style=\"color:#303638\">         logger.exception(</span></span>\n<span class=\"line\"><span style=\"color:#303638\">             \"An error occurred in `transformers` while applying chat template\"</span></span>\n<span class=\"line\"><span style=\"color:#303638\">         )</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">-</span><span style=\"color:#8D4B43\">        raise ValueError(str(e)) from e</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">+</span><span style=\"color:#3F6D55\">        raise ValueError(str(error)) from error</span></span>\n<span class=\"line\"><span style=\"color:#303638\"> </span></span>\n<span class=\"line\"><span style=\"color:#303638\"> </span></span>\n<span class=\"line\"><span style=\"color:#303638\"> def rebuild_mm_uuids_from_mm_data(</span></span></code></pre>","lineCount":74}
