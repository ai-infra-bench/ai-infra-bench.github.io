\"> final</span><span style=\"color:#686D67\">.</span><span style=\"color:#303638\">role</span><span style=\"color:#686D67\">,</span><span style=\"color:#8D4B43\"> \"events\"</span><span style=\"color:#686D67\">:</span><span style=\"color:#806D1A\"> len</span><span style=\"color:#686D67\">(</span><span style=\"color:#303638\">events</span><span style=\"color:#686D67\">),</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">                \"first_event\"</span><span style=\"color:#686D67\">:</span><span style=\"color:#303638\"> events</span><span style=\"color:#686D67\">[</span><span style=\"color:#2D6F7A\">0</span><span style=\"color:#686D67\">],</span><span style=\"color:#8D4B43\"> \"last_event\"</span><span style=\"color:#686D67\">:</span><span style=\"color:#303638\"> events</span><span style=\"color:#686D67\">[</span><span style=\"color:#3F6D55\">-</span><span style=\"color:#2D6F7A\">1</span><span style=\"color:#686D67\">],</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">                \"input_tokens\"</span><span style=\"color:#686D67\">:</span><span style=\"color:#303638\"> prompt_tokens</span><span style=\"color:#686D67\">(</span><span style=\"color:#303638\">final</span><span style=\"color:#686D67\">.</span><span style=\"color:#303638\">usage</span><span style=\"color:#686D67\">)}</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">    except</span><span style=\"color:#6E5C8A\"> Exception</span><span style=\"color:#3F6D55\"> as</span><span style=\"color:#303638\"> exc</span><span style=\"color:#686D67\">:</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">        return</span><span style=\"color:#303638\"> error</span><span style=\"color:#686D67\">(</span><span style=\"color:#303638\">exc</span><span style=\"color:#686D67\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">def</span><span style=\"color:#806D1A\"> referen