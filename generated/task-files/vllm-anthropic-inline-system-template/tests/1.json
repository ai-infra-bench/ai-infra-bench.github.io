{"highlightedHtml":"<pre class=\"shiki ai-infra-paper\" style=\"background-color:#F8F7F3;color:#303638\"><code><span class=\"line\"><span style=\"color:#686D67;font-style:italic\">#!/usr/bin/env python3</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">\"\"\"Observe both API modes and compare counting with generation's actual usage.\"\"\"</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">from</span><span style=\"color:#303638\"> __future__ </span><span style=\"color:#3F6D55\">import</span><span style=\"color:#303638\"> annotations</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">import</span><span style=\"color:#303638\"> json</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">import</span><span style=\"color:#303638\"> os</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">from</span><span style=\"color:#303638\"> pathlib </span><span style=\"color:#3F6D55\">import</span><span style=\"color:#303638\"> Path</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">import</span><span style=\"color:#303638\"> anthropic</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">from</span><span style=\"color:#303638\"> probe_contract </span><span style=\"color:#3F6D55\">import</span><span style=\"color:#303638\"> MODE_SPECS</span><span style=\"color:#686D67\">,</span><span style=\"color:#303638\"> cases</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">def</span><span style=\"color:#806D1A\"> error</span><span style=\"color:#686D67\">(</span><span style=\"color:#6E5C8A\">exc</span><span style=\"color:#686D67\">):</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">    if</span><span style=\"color:#806D1A\"> isinstance</span><span style=\"color:#686D67\">(</span><span style=\"color:#303638\">exc</span>