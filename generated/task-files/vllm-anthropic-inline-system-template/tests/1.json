/span><span style=\"color:#303638\"> model</span><span style=\"color:#686D67\">,</span><span style=\"color:#8D4B43\"> \"messages\"</span><span style=\"color:#686D67\">:</span><span style=\"color:#303638\"> case</span><span style=\"color:#686D67\">[</span><span style=\"color:#8D4B43\">\"messages\"</span><span style=\"color:#686D67\">]}</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">    if</span><span style=\"color:#8D4B43\"> \"system\"</span><span style=\"color:#3F6D55\"> in</span><span style=\"color:#303638\"> case</span><span style=\"color:#686D67\">:</span></span>\n<span class=\"line\"><span style=\"color:#303638\">        result</span><span style=\"color:#686D67\">[</span><span style=\"color:#8D4B43\">\"system\"</span><span style=\"color:#686D67\">]</span><span style=\"color:#3F6D55\"> =</span><span style=\"color:#303638\"> case</span><span style=\"color:#686D67\">[</span><span style=\"color:#8D4B43\">\"system\"</span><span style=\"color:#686D67\">]</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">    return</span><span style=\"color:#303638\"> result</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">def</span><span style=\"color:#806D1A\"> count_tokens</span><span style=\"color:#686D67\">(</span><span style=\"color:#6E5C8A\">client</span><span style=\"color:#686D67\">,</span><span style=\"color:#6E5C8A\"> kwargs</span><span style=\"color:#686D67\">):</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">    try</span><span style=\"color:#686D67\">:</span></span>\n<span class=\"line\"><span style=\"color:#303638\">        response </span><span style=\"color:#3F6D55\">=</span><span style=\"color:#303638\"> client</span><span style=\"color:#686D67\">.</span><span style=\"color:#303638\">messages</span><span style=\"color:#686D67\">.</span><span style=\"color:#303638\">count_tokens</span><span style=\"color:#686D67\">(</span><span style=\"color