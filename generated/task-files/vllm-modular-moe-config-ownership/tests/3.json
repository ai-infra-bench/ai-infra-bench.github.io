:#686D67\">,</span><span style=\"color:#6E5C8A\"> atol</span><span style=\"color:#3F6D55\">=</span><span style=\"color:#2D6F7A\">0</span><span style=\"color:#686D67\">)</span></span>\n<span class=\"line\"><span style=\"color:#303638\">                gathered </span><span style=\"color:#3F6D55\">=</span><span style=\"color:#686D67\"> [</span><span style=\"color:#303638\">torch</span><span style=\"color:#686D67\">.</span><span style=\"color:#303638\">cat</span><span style=\"color:#686D67\">([</span><span style=\"color:#303638\">rank</span><span style=\"color:#686D67\">[</span><span style=\"color:#303638\">key</span><span style=\"color:#686D67\">]</span><span style=\"color:#3F6D55\"> for</span><span style=\"color:#303638\"> rank </span><span style=\"color:#3F6D55\">in</span><span style=\"color:#303638\"> ranks</span><span style=\"color:#686D67\">])</span><span style=\"color:#3F6D55\"> for</span><span style=\"color:#303638\"> key </span><span style=\"color:#3F6D55\">in</span><span style=\"color:#686D67\"> (</span><span style=\"color:#8D4B43\">'weights'</span><span style=\"color:#686D67\">,</span><span style=\"color:#8D4B43\"> 'ids'</span><span style=\"color:#686D67\">,</span><span style=\"color:#8D4B43\"> 'x'</span><span style=\"color:#686D67\">)]</span></span>\n<span class=\"line\"><span style=\"color:#303638\">                events</span><span style=\"color:#686D67\">.</span><span style=\"color:#303638\">append</span><span style=\"color:#686D67\">({</span><span style=\"color:#8D4B43\">'kind'</span><span style=\"color:#686D67\">:</span><span style=\"color:#8D4B43\"> 'gather'</span><span style=\"color:#686D67\">,</span><span style=\"color:#8D4B43\"> 'sizes'</span><span style=\"color:#686D67\">:</span><span style=\"color:#6E5C8A\"> list</span><span style=\"color:#686D67\">(</span><span style=\"color:#303638\">sizes</span><span style=\"color:#686D67\">),</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">                               'sent'</span><span s