{"highlightedHtml":"<pre class=\"shiki ai-infra-paper\" style=\"background-color:#F8F7F3;color:#303638\"><code><span class=\"line\"><span style=\"color:#686D67;font-style:italic\">#!/usr/bin/env python3</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">\"\"\"Exercise public speech APIs with real WAV decoding and audio splitting.\"\"\"</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">from</span><span style=\"color:#303638\"> __future__ </span><span style=\"color:#3F6D55\">import</span><span style=\"color:#303638\"> annotations</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">import</span><span style=\"color:#303638\"> asyncio</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">from</span><span style=\"color:#303638\"> speech_harness </span><span style=\"color:#3F6D55\">import</span><span style=\"color:#303638\"> StubQwen3Model</span><span style=\"color:#686D67\">,</span><span style=\"color:#303638\"> run_public_speech_request</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">async</span><span style=\"color:#3F6D55\"> def</span><span style=\"color:#806D1A\"> run</span><span style=\"color:#686D67\">():</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    transcription </span><span style=\"color:#3F6D55\">=</span><span style=\"color:#3F6D55\"> await</span><span style=\"color:#303638\"> run_public_speech_request</span><span style=\"color:#686D67\">(</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">        \"transcription\"</span><span style=\"color:#686D67\">,</span></span>\n<span class=\"line\"><span style=\"color:#2D6F7A\">        True</span><span style=\"color:#686D67\">,</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">        \"en\"</span><span style=\"color:#686D67\">,</span></span>\n<span