{"highlightedHtml":"<pre class=\"shiki ai-infra-paper\" style=\"background-color:#F8F7F3;color:#303638\"><code><span class=\"line\"><span style=\"color:#686D67;font-style:italic\"># syntax=docker/dockerfile:1</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ARG</span><span style=\"color:#303638\"> BASE_IMAGE=vllm/vllm-openai-cpu@sha256:d19978a2d4bb2289c740a6c89d4cc15fbcf4d20d916f1e268168b8bbad3b776b</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">FROM</span><span style=\"color:#303638\"> ${BASE_IMAGE} </span><span style=\"color:#3F6D55\">AS</span><span style=\"color:#303638\"> prepared</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ARG</span><span style=\"color:#303638\"> BASE_IMAGE</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ARG</span><span style=\"color:#303638\"> VLLM_BASE_SHA=d88f28da05b12bc7d63ebe3dcedf445ecb274343</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ARG</span><span style=\"color:#303638\"> VLLM_BASE_TREE=037cc4e534167733500093aa225de6ab64a1028e</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ARG</span><span style=\"color:#303638\"> VLLM_REPO=https://github.com/vllm-project/vllm.git</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">USER</span><span style=\"color:#303638\"> 0:0</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ENV</span><span style=\"color:#303638\"> PATH=/opt/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    HF_HUB_OFFLINE=1 \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    TRANSFORMERS_OFFLINE=1 \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    HF_DATASETS_OFFLINE=1 \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    PIP_NO_INDEX=1 \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    PIP_DISABLE_PIP_VERSION_CHECK=1 \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    PYTHONDONTWRITEBYTECODE=1 \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    TOKENIZERS_PARALLELISM=false \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    TORCH_DEVICE_BACKEND_AUTOLOAD=0 \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    HOME=/home/agent</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">RUN</span><span style=\"color:#303638\"> case </span><span style=\"color:#8D4B43\">\"${BASE_IMAGE}\"</span><span style=\"color:#303638\"> in \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">      *@sha256:d19978a2d4bb2289c740a6c89d4cc15fbcf4d20d916f1e268168b8bbad3b776b) ;; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">      *) echo </span><span style=\"color:#8D4B43\">\"BASE_IMAGE must be the frozen v0.17.1 x86_64 CPU manifest\"</span><span style=\"color:#303638\"> >&#x26;2; exit 1 ;; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    esac</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#686D67;font-style:italic\"># Keep only compiled extensions and generated version metadata from the</span></span>\n<span class=\"line\"><span style=\"color:#686D67;font-style:italic\"># digest-pinned official release. Candidate Python source is supplied below.</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">RUN</span><span style=\"color:#303638\"> set -eu; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    installed_vllm=</span><span style=\"color:#8D4B43\">\"$(python3 -c 'import pathlib,vllm; print(pathlib.Path(vllm.__file__).resolve().parent)')\"</span><span style=\"color:#303638\">; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    mkdir -p /opt/vllm-native-overlay; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    cd </span><span style=\"color:#8D4B43\">\"${installed_vllm}\"</span><span style=\"color:#303638\">; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    find . -type f </span><span style=\"color:#2D6F7A\">\\(</span><span style=\"color:#303638\"> -name </span><span style=\"color:#8D4B43\">'*.so'</span><span style=\"color:#303638\"> -o -name </span><span style=\"color:#8D4B43\">'_version.py'</span><span style=\"color:#2D6F7A\"> \\)</span><span style=\"color:#303638\"> -print0 \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">      | tar --null --files-from=- -cf - \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">      | tar -C /opt/vllm-native-overlay -xf -; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    test -n </span><span style=\"color:#8D4B43\">\"$(find /opt/vllm-native-overlay -type f -name '*.so' -print -quit)\"</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#686D67;font-style:italic\"># Fetch the exact Base with its reachable history, then remove every remote,</span></span>\n<span class=\"line\"><span style=\"color:#686D67;font-style:italic\"># reflog and fetch artifact that could reveal post-cutoff source.</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">RUN</span><span style=\"color:#303638\"> set -eu; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    mkdir -p /app; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    cd /app; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    git init -q; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    git config core.logAllRefUpdates false; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    git config http.version HTTP/1.1; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    git remote add origin </span><span style=\"color:#8D4B43\">\"${VLLM_REPO}\"</span><span style=\"color:#303638\">; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    fetch_step() { \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">      for attempt in 1 2 3; do \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">        git fetch </span><span style=\"color:#8D4B43\">\"$@\"</span><span style=\"color:#303638\"> &#x26;&#x26; return 0; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">      done; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">      return 1; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    }; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    fetch_step --depth=2000 --no-tags origin </span><span style=\"color:#8D4B43\">\"${VLLM_BASE_SHA}\"</span><span style=\"color:#303638\">; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    while test -e .git/shallow; do \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">      fetch_step --deepen=2000 --no-tags origin </span><span style=\"color:#8D4B43\">\"${VLLM_BASE_SHA}\"</span><span style=\"color:#303638\">; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    done; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    git checkout -q -b main </span><span style=\"color:#8D4B43\">\"${VLLM_BASE_SHA}\"</span><span style=\"color:#303638\">; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    test </span><span style=\"color:#8D4B43\">\"$(git rev-parse HEAD)\"</span><span style=\"color:#303638\"> = </span><span style=\"color:#8D4B43\">\"${VLLM_BASE_SHA}\"</span><span style=\"color:#303638\">; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    test </span><span style=\"color:#8D4B43\">\"$(git rev-parse 'HEAD^{tree}')\"</span><span style=\"color:#303638\"> = </span><span style=\"color:#8D4B43\">\"${VLLM_BASE_TREE}\"</span><span style=\"color:#303638\">; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    git remote remove origin; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    rm -rf .git/logs; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    rm -f .git/FETCH_HEAD .git/ORIG_HEAD; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    test -z </span><span style=\"color:#8D4B43\">\"$(git remote)\"</span><span style=\"color:#303638\">; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    test -z </span><span style=\"color:#8D4B43\">\"$(git for-each-ref --format='%(refname)' refs/remotes refs/tags)\"</span><span style=\"color:#303638\">; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    test </span><span style=\"color:#8D4B43\">\"$(git rev-list --all --count)\"</span><span style=\"color:#303638\"> -gt 1; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    test ! -e .git/shallow; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    test -z </span><span style=\"color:#8D4B43\">\"$(git fsck --full --no-reflogs --unreachable --no-progress 2>/dev/null)\"</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">RUN</span><span style=\"color:#303638\"> set -eu; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    cp -a /opt/vllm-native-overlay/. /app/vllm/; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    cd /app; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    find /opt/vllm-native-overlay -type f -printf </span><span style=\"color:#8D4B43\">'/vllm/%P</span><span style=\"color:#2D6F7A\">\\n</span><span style=\"color:#8D4B43\">'</span><span style=\"color:#303638\"> \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">      | sort >> .git/info/exclude; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    site_dir=</span><span style=\"color:#8D4B43\">\"$(python3 -c 'import site; print(site.getsitepackages()[0])')\"</span><span style=\"color:#303638\">; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    printf </span><span style=\"color:#8D4B43\">'import sys; sys.path.insert(0, \"/app\")</span><span style=\"color:#2D6F7A\">\\n</span><span style=\"color:#8D4B43\">'</span><span style=\"color:#303638\"> \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">      > </span><span style=\"color:#8D4B43\">\"${site_dir}/vllm-candidate-source.pth\"</span><span style=\"color:#303638\">; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    cd /tmp; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    python3 -I -c </span><span style=\"color:#8D4B43\">'import importlib.util,pathlib,torch,vllm; root=pathlib.Path(\"/app\"); assert pathlib.Path(vllm.__file__).resolve().is_relative_to(root); spec=importlib.util.find_spec(\"vllm._C\"); assert spec and pathlib.Path(spec.origin).resolve().is_relative_to(root); assert torch.__version__ == \"2.10.0+cpu\"; assert torch.version.cuda is None; assert not torch.cuda.is_available()'</span><span style=\"color:#303638\">; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    cd /app; \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    test -z </span><span style=\"color:#8D4B43\">\"$(git status --porcelain=v1 --untracked-files=all)\"</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">RUN</span><span style=\"color:#303638\"> groupadd --gid 10001 agent \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    &#x26;&#x26; useradd --uid 10001 --gid 10001 --create-home --home-dir /home/agent agent \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    &#x26;&#x26; chown -R agent:agent /app /home/agent \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">    &#x26;&#x26; chmod -R a-w /opt/vllm-native-overlay</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">WORKDIR</span><span style=\"color:#303638\"> /app</span></span>\n<span class=\"line\"><span style=\"color:#686D67;font-style:italic\"># Keep the no-network agent phase usable by terminal-based benchmark agents.</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">USER</span><span style=\"color:#303638\"> 0:0</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">RUN</span><span style=\"color:#303638\"> apt-get -o Acquire::Retries=3 \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">        -o Acquire::http::Timeout=30 \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\">        -o Acquire::https::Timeout=30 update \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\"> &#x26;&#x26; DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends tmux \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\"> &#x26;&#x26; rm -rf /var/lib/apt/lists/*</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">COPY</span><span style=\"color:#303638\"> lock/requirements.txt /tmp/upstream-test-requirements.txt</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">RUN</span><span style=\"color:#303638\"> PIP_NO_INDEX=0 /opt/venv/bin/python -m pip install --no-cache-dir -r /tmp/upstream-test-requirements.txt</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#686D67;font-style:italic\"># Normal upstream scheduler tests use this public, pre-cutoff OPT and LLaVA metadata.</span></span>\n<span class=\"line\"><span style=\"color:#686D67;font-style:italic\"># No weights, task-specific reproducers, or hidden test inputs are included.</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">COPY</span><span style=\"color:#303638\"> lock/hf-cache/ /home/agent/.cache/huggingface/hub/</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">RUN</span><span style=\"color:#303638\"> chown -R agent:agent /home/agent/.cache</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#686D67;font-style:italic\"># The source checkout, not a readable donor wheel, is the only vLLM source.</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">RUN</span><span style=\"color:#303638\"> test -f /opt/venv/lib/python3.12/site-packages/vllm/v1/core/sched/scheduler.py \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\"> &#x26;&#x26; test -f /app/vllm/v1/core/sched/scheduler.py \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\"> &#x26;&#x26; rm -rf /opt/venv/lib/python3.12/site-packages/vllm /root/.cache/uv /vllm-workspace \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\"> &#x26;&#x26; ln -s /app/vllm /opt/venv/lib/python3.12/site-packages/vllm \\</span></span>\n<span class=\"line\"><span style=\"color:#303638\"> &#x26;&#x26; python -c </span><span style=\"color:#8D4B43\">'import pathlib,vllm; assert pathlib.Path(vllm.__file__).resolve().is_relative_to(\"/app\")'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#686D67;font-style:italic\"># Export only the sanitized filesystem; donor source cannot survive in layers.</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">FROM</span><span style=\"color:#303638\"> scratch</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">COPY</span><span style=\"color:#303638\"> --from=prepared / /</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ENV</span><span style=\"color:#303638\"> PATH=</span><span style=\"color:#8D4B43\">\"/opt/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\"</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ENV</span><span style=\"color:#303638\"> CC=</span><span style=\"color:#8D4B43\">\"/usr/bin/gcc-12\"</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ENV</span><span style=\"color:#303638\"> CXX=</span><span style=\"color:#8D4B43\">\"/usr/bin/g++-12\"</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ENV</span><span style=\"color:#303638\"> CCACHE_DIR=</span><span style=\"color:#8D4B43\">\"/root/.cache/ccache\"</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ENV</span><span style=\"color:#303638\"> CMAKE_CXX_COMPILER_LAUNCHER=</span><span style=\"color:#8D4B43\">\"ccache\"</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ENV</span><span style=\"color:#303638\"> VIRTUAL_ENV=</span><span style=\"color:#8D4B43\">\"/opt/venv\"</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ENV</span><span style=\"color:#303638\"> UV_PYTHON_INSTALL_DIR=</span><span style=\"color:#8D4B43\">\"/opt/uv/python\"</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ENV</span><span style=\"color:#303638\"> UV_HTTP_TIMEOUT=</span><span style=\"color:#8D4B43\">\"500\"</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ENV</span><span style=\"color:#303638\"> PIP_EXTRA_INDEX_URL=</span><span style=\"color:#8D4B43\">\"https://download.pytorch.org/whl/cpu\"</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ENV</span><span style=\"color:#303638\"> UV_EXTRA_INDEX_URL=</span><span style=\"color:#8D4B43\">\"https://download.pytorch.org/whl/cpu\"</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ENV</span><span style=\"color:#303638\"> UV_INDEX_STRATEGY=</span><span style=\"color:#8D4B43\">\"unsafe-best-match\"</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ENV</span><span style=\"color:#303638\"> UV_LINK_MODE=</span><span style=\"color:#8D4B43\">\"copy\"</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ENV</span><span style=\"color:#303638\"> TARGETARCH=</span><span style=\"color:#8D4B43\">\"amd64\"</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ENV</span><span style=\"color:#303638\"> LD_PRELOAD=</span><span style=\"color:#8D4B43\">\"/usr/lib/x86_64-linux-gnu/libtcmalloc_minimal.so.4:/opt/venv/lib/libiomp5.so\"</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ENV</span><span style=\"color:#303638\"> HF_HUB_OFFLINE=</span><span style=\"color:#8D4B43\">\"1\"</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ENV</span><span style=\"color:#303638\"> TRANSFORMERS_OFFLINE=</span><span style=\"color:#8D4B43\">\"1\"</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ENV</span><span style=\"color:#303638\"> HF_DATASETS_OFFLINE=</span><span style=\"color:#8D4B43\">\"1\"</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ENV</span><span style=\"color:#303638\"> PIP_NO_INDEX=</span><span style=\"color:#8D4B43\">\"1\"</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ENV</span><span style=\"color:#303638\"> PIP_DISABLE_PIP_VERSION_CHECK=</span><span style=\"color:#8D4B43\">\"1\"</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ENV</span><span style=\"color:#303638\"> PYTHONDONTWRITEBYTECODE=</span><span style=\"color:#8D4B43\">\"1\"</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ENV</span><span style=\"color:#303638\"> PYTEST_DISABLE_PLUGIN_AUTOLOAD=</span><span style=\"color:#8D4B43\">\"1\"</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ENV</span><span style=\"color:#303638\"> TOKENIZERS_PARALLELISM=</span><span style=\"color:#8D4B43\">\"false\"</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ENV</span><span style=\"color:#303638\"> TORCH_DEVICE_BACKEND_AUTOLOAD=</span><span style=\"color:#8D4B43\">\"0\"</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ENV</span><span style=\"color:#303638\"> HOME=</span><span style=\"color:#8D4B43\">\"/home/agent\"</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ENV</span><span style=\"color:#303638\"> HF_HOME=</span><span style=\"color:#8D4B43\">\"/home/agent/.cache/huggingface\"</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">USER</span><span style=\"color:#303638\"> 10001:10001</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">WORKDIR</span><span style=\"color:#303638\"> /app</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">ENTRYPOINT</span><span style=\"color:#303638\"> []</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">CMD</span><span style=\"color:#303638\"> [</span><span style=\"color:#8D4B43\">\"sleep\"</span><span style=\"color:#303638\">, </span><span style=\"color:#8D4B43\">\"infinity\"</span><span style=\"color:#303638\">]</span></span></code></pre>","lineCount":143}
