le=\"color:#686D67\">,</span><span style=\"color:#3F6D55\"> *</span><span style=\"color:#303638\">args</span><span style=\"color:#686D67\">,</span><span style=\"color:#3F6D55\"> **</span><span style=\"color:#303638\">kwargs</span><span style=\"color:#686D67\">)</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">        finally</span><span style=\"color:#686D67\">:</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">            with</span><span style=\"color:#303638\"> state_lock</span><span style=\"color:#686D67\">:</span></span>\n<span class=\"line\"><span style=\"color:#303638\">                active_instances</span><span style=\"color:#686D67\">.</span><span style=\"color:#303638\">discard</span><span style=\"color:#686D67\">(</span><span style=\"color:#303638\">identity</span><span style=\"color:#686D67\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">    def</span><span style=\"color:#806D1A\"> encode_after_rendezvous</span><span style=\"color:#686D67\">(</span><span style=\"color:#6E5C8A\">prompt</span><span style=\"color:#686D67\">:</span><span style=\"color:#6E5C8A\"> str</span><span style=\"color:#686D67\">):</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">        nonlocal</span><span style=\"color:#303638\"> ready_callers</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">        with</span><span style=\"color:#303638\"> state_lock</span><span style=\"color:#686D67\">:</span></span>\n<span class=\"line\"><span style=\"color:#303638\">            ready_callers </span><span style=\"color:#3F6D55\">+=</span><span style=\"color:#2D6F7A\"> 1</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">            if</span><span style=\"color:#303638\"> ready_callers </span><span style=\"color:#3F6D55\">==</span><span style=\"color:#2D6F7A\"> 2</span><span style=\"color:#686D67\">:</span></span>\n<span class=\"line\"><span style=\"color:#303638\