{"highlightedHtml":"<pre class=\"shiki ai-infra-paper\" style=\"background-color:#F8F7F3;color:#303638\"><code><span class=\"line\"><span style=\"color:#686D67;font-style:italic\">#!/usr/bin/env bash</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">set</span><span style=\"color:#8D4B43\"> -uo</span><span style=\"color:#8D4B43\"> pipefail</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">mkdir</span><span style=\"color:#8D4B43\"> -p</span><span style=\"color:#8D4B43\"> /logs/verifier</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">cd</span><span style=\"color:#8D4B43\"> /workspace/vllm</span></span>\n<span class=\"line\"><span style=\"color:#303638\">pytest_rc</span><span style=\"color:#3F6D55\">=</span><span style=\"color:#8D4B43\">0</span></span>\n<span class=\"line\"><span style=\"color:#303638\">integrity_rc</span><span style=\"color:#3F6D55\">=</span><span style=\"color:#8D4B43\">0</span></span>\n<span class=\"line\"><span style=\"color:#303638\">ray_rc</span><span style=\"color:#3F6D55\">=</span><span style=\"color:#8D4B43\">0</span></span>\n<span class=\"line\"><span style=\"color:#303638\">app_rc</span><span style=\"color:#3F6D55\">=</span><span style=\"color:#8D4B43\">0</span></span>\n<span class=\"line\"><span style=\"color:#303638\">PYTEST_DISABLE_PLUGIN_AUTOLOAD</span><span style=\"color:#3F6D55\">=</span><span style=\"color:#8D4B43\">1</span><span style=\"color:#806D1A\"> timeout</span><span style=\"color:#2D6F7A\"> 900</span><span style=\"color:#2D6F7A\"> \\</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">  pytest</span><span style=\"color:#8D4B43\"> --noconftest</span><span style=\"color:#8D4B43\"> -c</span><span style=\"color:#8D4B43\"> /dev/null</span><span style=\"color:#8D4B43\"> --rootdir=/workspace/vllm</span><span style=\"color:#2D6F7A\"> \\</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">    -p</span><span style=\"color:#8D4B43\"> no:cacheprovider</span><span