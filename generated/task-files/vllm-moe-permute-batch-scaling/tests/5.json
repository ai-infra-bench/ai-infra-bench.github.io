7A\"> 1</span><span style=\"color:#686D67\">,</span><span style=\"color:#3F6D55\"> -</span><span style=\"color:#2D6F7A\">1</span><span style=\"color:#686D67\">,</span><span style=\"color:#3F6D55\"> -</span><span style=\"color:#2D6F7A\">1</span><span style=\"color:#686D67\">,</span><span style=\"color:#2D6F7A\"> 2</span><span style=\"color:#686D67\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">def</span><span style=\"color:#806D1A\"> routes_for</span><span style=\"color:#686D67\">(</span><span style=\"color:#6E5C8A\">name</span><span style=\"color:#686D67\">):</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">    if</span><span style=\"color:#303638\"> name </span><span style=\"color:#3F6D55\">==</span><span style=\"color:#8D4B43\"> \"mixed\"</span><span style=\"color:#686D67\">:</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">        return</span><span style=\"color:#686D67\"> [(</span><span style=\"color:#2D6F7A\">5</span><span style=\"color:#3F6D55\"> *</span><span style=\"color:#303638\"> t </span><span style=\"color:#3F6D55\">+</span><span style=\"color:#2D6F7A\"> 3</span><span style=\"color:#3F6D55\"> *</span><span style=\"color:#303638\"> k</span><span style=\"color:#686D67\">)</span><span style=\"color:#3F6D55\"> %</span><span style=\"color:#303638\"> EXPERTS </span><span style=\"color:#3F6D55\">for</span><span style=\"color:#303638\"> t </span><span style=\"color:#3F6D55\">in</span><span style=\"color:#806D1A\"> range</span><span style=\"color:#686D67\">(</span><span style=\"color:#303638\">TOKENS</span><span style=\"color:#686D67\">)</span><span style=\"color:#3F6D55\"> for</span><span style=\"color:#303638\"> k </span><span style=\"color:#3F6D55\">in</span><span style=\"color:#806D1A\"> range</span><span style=\"color:#686D67\">(</span><span style=\"color:#303638\">TOPK</span><span style=\"color:#686D67\">)]</span></span>\n<span class=\"line