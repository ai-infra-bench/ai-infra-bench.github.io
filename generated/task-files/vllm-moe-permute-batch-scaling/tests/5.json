 and NaNs.</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">    return</span><span style=\"color:#6E5C8A\"> bytes</span><span style=\"color:#686D67\">((</span><span style=\"color:#2D6F7A\">37</span><span style=\"color:#3F6D55\"> *</span><span style=\"color:#303638\"> t </span><span style=\"color:#3F6D55\">+</span><span style=\"color:#303638\"> col</span><span style=\"color:#686D67\">)</span><span style=\"color:#3F6D55\"> %</span><span style=\"color:#2D6F7A\"> 256</span><span style=\"color:#3F6D55\"> for</span><span style=\"color:#303638\"> t </span><span style=\"color:#3F6D55\">in</span><span style=\"color:#806D1A\"> range</span><span style=\"color:#686D67\">(</span><span style=\"color:#303638\">TOKENS</span><span style=\"color:#686D67\">)</span><span style=\"color:#3F6D55\"> for</span><span style=\"color:#303638\"> col </span><span style=\"color:#3F6D55\">in</span><span style=\"color:#806D1A\"> range</span><span style=\"color:#686D67\">(</span><span style=\"color:#303638\">HIDDEN</span><span style=\"color:#686D67\">))</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">def</span><span style=\"color:#806D1A\"> case_key</span><span style=\"color:#686D67\">(</span><span style=\"color:#6E5C8A\">name</span><span style=\"color:#686D67\">,</span><span style=\"color:#6E5C8A\"> aligned</span><span style=\"color:#686D67\">):</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">    return</span><span style=\"color:#3F6D55\"> f</span><span style=\"color:#8D4B43\">\"partition=</span><span style=\"color:#2D6F7A\">{</span><span style=\"color:#303638\">name</span><span style=\"color:#2D6F7A\">}</span><span style=\"color:#8D4B43\">:</span><span style=\"color:#2D6F7A\">{</span><span style=\"color:#8D4B43\">'aligned'</span><span style=\"color:#3F6D55\"> if</span><span style=\"color:#303638\"> aligned </span><span style=\"color:#3F6D55\">else</span><span style=\"color:#8D4B43\"> 'un