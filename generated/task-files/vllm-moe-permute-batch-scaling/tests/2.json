{"highlightedHtml":"<pre class=\"shiki ai-infra-paper\" style=\"background-color:#F8F7F3;color:#303638\"><code><span class=\"line\"><span style=\"color:#686D67;font-style:italic\">#!/bin/sh</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">set</span><span style=\"color:#8D4B43\"> -eu</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#303638\">source_digest</span><span style=\"color:#3F6D55\">=</span><span style=\"color:#8D4B43\">\"</span><span style=\"color:#686D67\">$(</span><span style=\"color:#8D4B43\">{</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">  find</span><span style=\"color:#8D4B43\"> /workspace/vllm/csrc/moe -type f -print0</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">  printf</span><span style=\"color:#8D4B43\"> '%s\\0' /workspace/vllm/CMakeLists.txt</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">} | sort -z | xargs -0 sha256sum | sha256sum | awk '{print $1}')\"</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">printf</span><span style=\"color:#8D4B43\"> 'candidate_source_sha256=%s\\n' \"</span><span style=\"color:#686D67\">${</span><span style=\"color:#8D4B43\">source_digest</span><span style=\"color:#686D67\">}</span><span style=\"color:#8D4B43\">\"</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">printf</span><span style=\"color:#8D4B43\"> 'build_command=cmake --build /workspace/vllm/build -j 8 --target _moe_C\\n'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">nvidia_site</span><span style=\"color:#3F6D55\">=</span><span style=\"color:#8D4B43\">/usr/local/lib/python3.12/dist-packages/nvidia</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">nvidia_includes</span><span style=\"color:#3F6D55\">=</span><span style=\"color:#8D4B43\">\"</span><span style=\"color:#686D67\">$(</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">  find</span><span style=\"color:#8D4B43\"> \"</span><span style=\"color:#686D67\">${</span><span style=\"color:#8D4B43\">nvidia_site</span><span style=\"color:#686D67\">}</span><span style=\"color:#8D4B43\">\" -mindepth </span><span style=\"color:#2D6F7A\">2</span><span style=\"color:#8D4B43\"> -maxdepth </span><span style=\"color:#2D6F7A\">2</span><span style=\"color:#8D4B43\"> -type d -name include -print </span><span style=\"color:#2D6F7A\">\\</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">    |</span><span style=\"color:#806D1A\"> sort</span><span style=\"color:#2D6F7A\"> \\</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">    |</span><span style=\"color:#806D1A\"> paste</span><span style=\"color:#8D4B43\"> -sd: -</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">)</span><span style=\"color:#8D4B43\">\"</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">test</span><span style=\"color:#8D4B43\"> -n \"</span><span style=\"color:#686D67\">${</span><span style=\"color:#8D4B43\">nvidia_includes</span><span style=\"color:#686D67\">}</span><span style=\"color:#8D4B43\">\"</span></span>\n<span class=\"line\"><span style=\"color:#3F6D55\">export</span><span style=\"color:#8D4B43\"> CPATH</span><span style=\"color:#3F6D55\">=</span><span style=\"color:#8D4B43\">\"</span><span style=\"color:#686D67\">${</span><span style=\"color:#8D4B43\">nvidia_includes</span><span style=\"color:#686D67\">}${</span><span style=\"color:#8D4B43\">CPATH</span><span style=\"color:#3F6D55\">:</span><span style=\"color:#8D4B43\">+</span><span style=\"color:#3F6D55\">:</span><span style=\"color:#686D67\">${</span><span style=\"color:#8D4B43\">CPATH</span><span style=\"color:#686D67\">}}</span><span style=\"color:#8D4B43\">\"</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">cmake_file</span><span style=\"color:#3F6D55\">=</span><span style=\"color:#8D4B43\">/workspace/vllm/CMakeLists.txt</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">cmake_backup</span><span style=\"color:#3F6D55\">=</span><span style=\"color:#8D4B43\">\"</span><span style=\"color:#686D67\">$(</span><span style=\"color:#806D1A\">mktemp</span><span style=\"color:#8D4B43\"> /tmp/vllm-cmake.XXXXXX</span><span style=\"color:#686D67\">)</span><span style=\"color:#8D4B43\">\"</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">cp</span><span style=\"color:#8D4B43\"> -p \"</span><span style=\"color:#686D67\">${</span><span style=\"color:#8D4B43\">cmake_file</span><span style=\"color:#686D67\">}</span><span style=\"color:#8D4B43\">\" \"</span><span style=\"color:#686D67\">${</span><span style=\"color:#8D4B43\">cmake_backup</span><span style=\"color:#686D67\">}</span><span style=\"color:#8D4B43\">\"</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">restore_cmake</span><span style=\"color:#686D67\">()</span><span style=\"color:#686D67\"> {</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">  mv</span><span style=\"color:#8D4B43\"> \"</span><span style=\"color:#686D67\">${</span><span style=\"color:#8D4B43\">cmake_backup</span><span style=\"color:#686D67\">}</span><span style=\"color:#8D4B43\">\" \"</span><span style=\"color:#686D67\">${</span><span style=\"color:#8D4B43\">cmake_file</span><span style=\"color:#686D67\">}</span><span style=\"color:#8D4B43\">\"</span></span>\n<span class=\"line\"><span style=\"color:#686D67\">}</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">trap</span><span style=\"color:#8D4B43\"> restore_cmake EXIT HUP INT TERM</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#686D67;font-style:italic\"># The upstream top-level project declares unrelated Triton, FlashMLA, Qutlass</span></span>\n<span class=\"line\"><span style=\"color:#686D67;font-style:italic\"># and flash-attention FetchContent projects after defining `_moe_C`. This</span></span>\n<span class=\"line\"><span style=\"color:#686D67;font-style:italic\"># focused task neither builds nor imports them. Temporarily end configuration</span></span>\n<span class=\"line\"><span style=\"color:#686D67;font-style:italic\"># after the exact target definition so rebuilds remain fully offline. The</span></span>\n<span class=\"line\"><span style=\"color:#686D67;font-style:italic\"># candidate CMakeLists bytes are restored even if configure/build fails.</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">python3</span><span style=\"color:#8D4B43\"> - \"</span><span style=\"color:#686D67\">${</span><span style=\"color:#8D4B43\">cmake_file</span><span style=\"color:#686D67\">}</span><span style=\"color:#8D4B43\">\" </span><span style=\"color:#3F6D55\">&#x3C;&#x3C;</span><span style=\"color:#8D4B43\">'PY'</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">import pathlib</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">import sys</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">path = pathlib.Path(sys.argv[1])</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">text = path.read_text()</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">marker = \"\\n# For CUDA and HIP builds also build the triton_kernels external package.\\n\"</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">assert text.count(marker) == 1</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">path.write_text(text.replace(marker, \"\\nreturn()\\n\" + marker))</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">PY</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#806D1A\">cmake</span><span style=\"color:#8D4B43\"> -S /workspace/vllm -B /workspace/vllm/build -G Ninja </span><span style=\"color:#2D6F7A\">\\</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">  -DCMAKE_BUILD_TYPE=Release </span><span style=\"color:#2D6F7A\">\\</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">  -DCMAKE_CUDA_ARCHITECTURES=80 </span><span style=\"color:#2D6F7A\">\\</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">  -DCMAKE_CUDA_COMPILER=/usr/local/cuda/bin/nvcc </span><span style=\"color:#2D6F7A\">\\</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">  -DCMAKE_INSTALL_PREFIX=/workspace/vllm </span><span style=\"color:#2D6F7A\">\\</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">  -DCUDA_nvrtc_LIBRARY=/usr/local/lib/python3.12/dist-packages/nvidia/cuda_nvrtc/lib/libnvrtc.so.12 </span><span style=\"color:#2D6F7A\">\\</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">  -DFETCHCONTENT_BASE_DIR=/workspace/vllm/.deps </span><span style=\"color:#2D6F7A\">\\</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">  -DNVCC_THREADS=2 </span><span style=\"color:#2D6F7A\">\\</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">  -DVLLM_CUTLASS_SRC_DIR=/opt/cutlass </span><span style=\"color:#2D6F7A\">\\</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">  -DVLLM_PYTHON_EXECUTABLE=/usr/bin/python3 </span><span style=\"color:#2D6F7A\">\\</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">  -DVLLM_TARGET_DEVICE=cuda</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">cmake</span><span style=\"color:#8D4B43\"> --build /workspace/vllm/build -j </span><span style=\"color:#2D6F7A\">8</span><span style=\"color:#8D4B43\"> --target _moe_C</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">cmake</span><span style=\"color:#8D4B43\"> --install /workspace/vllm/build --prefix /workspace/vllm --component _moe_C</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#806D1A\">restore_cmake</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">trap</span><span style=\"color:#8D4B43\"> - EXIT HUP INT TERM</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">native</span><span style=\"color:#3F6D55\">=</span><span style=\"color:#8D4B43\">\"</span><span style=\"color:#686D67\">$(</span><span style=\"color:#806D1A\">find</span><span style=\"color:#8D4B43\"> /workspace/vllm/vllm -maxdepth </span><span style=\"color:#2D6F7A\">1</span><span style=\"color:#8D4B43\"> -type f -name '_moe_C*.so' -print -quit</span><span style=\"color:#686D67\">)</span><span style=\"color:#8D4B43\">\"</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">test</span><span style=\"color:#8D4B43\"> -n \"</span><span style=\"color:#686D67\">${</span><span style=\"color:#8D4B43\">native</span><span style=\"color:#686D67\">}</span><span style=\"color:#8D4B43\">\"</span></span>\n<span class=\"line\"><span style=\"color:#8D4B43\">native_digest</span><span style=\"color:#3F6D55\">=</span><span style=\"color:#8D4B43\">\"</span><span style=\"color:#686D67\">$(</span><span style=\"color:#806D1A\">sha256sum</span><span style=\"color:#8D4B43\"> \"</span><span style=\"color:#686D67\">${</span><span style=\"color:#8D4B43\">native</span><span style=\"color:#686D67\">}</span><span style=\"color:#8D4B43\">\" </span><span style=\"color:#3F6D55\">|</span><span style=\"color:#806D1A\"> awk</span><span style=\"color:#8D4B43\"> '{print $1}'</span><span style=\"color:#686D67\">)</span><span style=\"color:#8D4B43\">\"</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">printf</span><span style=\"color:#8D4B43\"> 'native_extension=%s\\n' \"</span><span style=\"color:#686D67\">${</span><span style=\"color:#8D4B43\">native</span><span style=\"color:#686D67\">}</span><span style=\"color:#8D4B43\">\"</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">printf</span><span style=\"color:#8D4B43\"> 'native_sha256=%s\\n' \"</span><span style=\"color:#686D67\">${</span><span style=\"color:#8D4B43\">native_digest</span><span style=\"color:#686D67\">}</span><span style=\"color:#8D4B43\">\"</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#686D67;font-style:italic\"># NOTE: no cold-import self-check here.</span></span>\n<span class=\"line\"><span style=\"color:#686D67;font-style:italic\">#</span></span>\n<span class=\"line\"><span style=\"color:#686D67;font-style:italic\"># This script runs as the unprivileged `agent` user and is candidate-influenced,</span></span>\n<span class=\"line\"><span style=\"color:#686D67;font-style:italic\"># so nothing it prints is trusted for scoring. Resolving the module through</span></span>\n<span class=\"line\"><span style=\"color:#686D67;font-style:italic\"># importlib.util.find_spec(\"vllm._moe_C\") would additionally import the</span></span>\n<span class=\"line\"><span style=\"color:#686D67;font-style:italic\"># candidate `vllm` package; the authoritative discovery, symlink rejection and</span></span>\n<span class=\"line\"><span style=\"color:#686D67;font-style:italic\"># SHA-256 freeze are performed afterwards by root in</span></span>\n<span class=\"line\"><span style=\"color:#686D67;font-style:italic\"># /tests/trusted_stage_native.py, which never imports candidate code.</span></span>\n<span class=\"line\"><span style=\"color:#806D1A\">printf</span><span style=\"color:#8D4B43\"> 'build_completed=1\\n'</span></span></code></pre>","lineCount":75}
