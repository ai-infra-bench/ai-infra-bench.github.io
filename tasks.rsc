arallel decoding with direct GPU token handoff.","keywords":["vllm","pipeline-parallel","nccl","async-scheduling"],"domain":"inference","taskType":"feature","repository":"vllm-project/vllm","gpus":2,"gpuTypes":["A100"]},{"slug":"vllm-async-spec-placeholder-discard","name":"ai-infra-bench/vllm-async-spec-placeholder-discard","version":"1.0.0","description":"Prevent scheduler crashes during prefix-cache resets with asynchronous speculative decoding.","keywords":["vllm","async-scheduling","speculative-decoding","prefix-cache"],"domain":"inference","taskType":"bugfix","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]},{"slug":"vllm-concurrent-config-refresh","name":"ai-infra-bench/vllm-concurrent-config-refresh","version":"1.0.0","description":"Fix intermittent model-configuration read failures during concurrent API server startup.","keywords":["vllm","configuration","concurrency"],"domain":"inference","taskType":"bugfix","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]},{"slug":"vllm-cpu-offload-reset-inflight","name":"ai-infra-bench/vllm-cpu-offload-reset-inflight","version":"1.0.0","description":"Support CPU-offload cache resets that safely handle in-flight transfers.","keywords":["vllm","kv-offload","prefix-cache","concurrency"],"domain":"inference","taskType":"feature","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]},{"slug":"vllm-deterministic-bmm-batch-scaling","name":"ai-infra-bench/vllm-deterministic-bmm-batch-scaling","version":"1.0.0","description":"Improve deterministic batched matrix multiplication performance as batch size grows.","keywords":["vllm","triton","bmm","determinism"],"domain":"inference","taskType":"performance","repository":"vllm-project/vllm","gpus":1,"gpuTypes":["A100"]},{"slug":"vllm-dp-multi-port-supervisor","name":"ai-infra-bench/vllm-dp-multi-port-supervisor","version":"1.0.0","description":"Add coordinated startup, health checks, and shutdown for data-parallel API servers on separate ports.","keywords":["vllm","data-parallel","supervisor","health-check"],"domain":"inference","taskType":"feature","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]},{"slug":"vllm-fused-moe-config-lifecycle","name":"ai-infra-bench/vllm-fused-moe-config-lifecycle","version":"1.0.0","description":"Preserve layer configuration through fused-MoE profiling and execution without spurious warnings.","keywords":["vllm","moe","parallel-config","profiling"],"domain":"inference","taskType":"bugfix","repository":"vllm-project/vllm","gpus":1,"gpuTypes":["A100"]},{"slug":"vllm-implement-anthropic-rust-serving","name":"ai-infra-bench/vllm-implement-anthropic-rust-serving","version":"1.0.0","description":"Support Anthropic Messages and token counting in the Rust frontend.","keywords":["vllm","rust","anthropic","serving-api"],"domain":"inference","taskType":"feature","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]},{"slug":"vllm-kv-admission-thrashing","name":"ai-infra-bench/vllm-kv-admission-thrashing","version":"1.0.0","description":"Prevent repeated preemption from starving long prompts and active decoding under KV-cache pressure.","keywords":["vllm","scheduler","kv-cache","preemption"],"domain":"inference","taskType":"bugfix","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]},{"slug":"vllm-kv-connector-lifecycle","name":"ai-infra-bench/vllm-kv-connector-lifecycle","version":"1.0.0","description":"Reject legacy KV connector constructors while preserving current plugin initialization and shutdown.","keywords":["vllm","kv-connector","api-compatibility","lifecycle"],"domain":"inference","taskType":"bugfix","repository":"vllm-project/vllm","gpus":0,"gpuTypes":[]},{"slug":"vllm-minimax-m3-streaming-reasoning","name":"ai-infra-bench/vllm-minimax-m3-streaming-reasoning","version":"1.0.0","description":"Correct MiniMax M3 streaming reasoning and tool calls across thinking modes.","keywords":["vllm","minimax-m3","reasoning","streaming"],"domain":"inference","taskType":"bugfix","repository":"vllm-proje