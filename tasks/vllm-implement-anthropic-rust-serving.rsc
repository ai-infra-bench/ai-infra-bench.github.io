1:["$","main",null,{"className":"task-page","children":[["$","header",null,{"className":"site-header","children":["$","div",null,{"className":"chrome-inner","children":[["$","a",null,{"className":"header-name","href":"/","aria-current":"$undefined","children":"AI Infra Bench"}],["$","nav",null,{"aria-label":"Primary navigation","children":[["$","a",null,{"href":"/leaderboard.html","aria-current":"$undefined","children":"Leaderboard"}],["$","a",null,{"href":"/tasks.html","aria-current":"page","children":"Tasks"}],["$","a",null,{"className":"github-link","href":"https://github.com/ai-infra-bench/ai-infra-bench","children":"GitHub"}]]}]]}]}],["$","article",null,{"className":"task-detail","children":[["$","header",null,{"className":"task-detail-heading","children":[["$","h1",null,{"children":"Implement Anthropic Rust Serving"}],["$","p",null,{"children":"Support Anthropic Messages and token counting in the Rust frontend."}]]}],["$","$La",null,{"instructionHtml":"<p>Implement an Anthropic-compatible inference server in vLLM's Rust frontend that is fully compatible with <code>anthropic==1.3.0</code>.\nAll functionality exposed by the SDK's Messages and token-counting interfaces must work correctly when the SDK is configured to use the local vLLM server.\nThe implementation must work when vLLM is started with <code>VLLM_USE_RUST_FRONTEND=1</code>, and it must preserve the Rust frontend's existing APIs.\nMessage Batches and other Anthropic SDK resources outside the Messages and token-counting interfaces are out of scope. The Rust frontend must serve the requests itself rather than forwarding them to the Python frontend. For tools that are hosted by Anthropic's platform, compatibility means accepting their SDK request types and conversation content blocks; local vLLM is not expected to execute external Anthropic services.</p>","verifierFiles":[{"name":"test.sh","lineCount":71,"url":"/generated/task-files/vllm-implement-anthropic-rust-serving/tests/0.json"},{"name":"check_junit.py","lineCount":39,"url":"/generated/task-files/vllm-implement-anthropic-rust-serving/tests/1.json"},{"name":"protocol_fixture.py","lineCount":451,"url":"/generated/task-files/vllm-implement-anthropic-rust-serving/tests/2.json"},{"name":"python_frontend_control.py","lineCount":274,"url":"/generated/task-files/vllm-implement-anthropic-rust-serving/tests/3.json"},{"name":"test_real_qwen_backend.py","lineCount":240,"url":"/generated/task-files/vllm-implement-anthropic-rust-serving/tests/4.json"},{"name":"test_rust_historical_regressions.py","lineCount":219,"url":"/generated/task-files/vllm-implement-anthropic-rust-serving/tests/5.json"},{"name":"test_rust_request_matrix.py","lineCount":547,"url":"/generated/task-files/vllm-implement-anthropic-rust-serving/tests/6.json"},{"name":"test_rust_sdk_matrix.py","lineCount":437,"url":"/generated/task-files/vllm-implement-anthropic-rust-serving/tests/7.json"},{"name":"test_sdk_fixture.py","lineCount":409,"url":"/generated/task-files/vllm-implement-anthropic-rust-serving/tests/8.json"},{"name":"verifier_support.py","lineCount":260,"url":"/generated/task-files/vllm-implement-anthropic-rust-serving/tests/9.json"},{"name":"vllm_server_http_harness.rs","lineCount":440,"url":"/generated/task-files/vllm-implement-anthropic-rust-serving/tests/10.json"}],"solutionFiles":[],"environmentFiles":[{"name":"Dockerfile","lineCount":789,"url":"/generated/task-files/vllm-implement-anthropic-rust-serving/environment/0.json"},{"name":"build-config.json","lineCount":7,"url":"/generated/task-files/vllm-implement-anthropic-rust-serving/environment/1.json"},{"name":"image-manifest.json","lineCount":8,"url":"/generated/task-files/vllm-implement-anthropic-rust-serving/environment/2.json"},{"name":"lock/extras.in","lineCount":4,"url":"/generated/task-files/vllm-implement-anthropic-rust-serving/environment/3.json"},{"name":"lock/manifest.json","lineCount":38,"url":"/generated/task-files/vllm-implement-anthropic-rust-serving/environment/4.json"},{"name":"lock/requirements.txt","lineCount":559,"url":"/generated/task-files/vllm-implement-anthropic-rust-serving/environment/5.json"}],"metadataGroups":[{"title":"Task","facts":[["Task Type","Feature"],["Keywords","rust, anthropic, serving-api"]]},{"title":"Compute","facts":[["GPUs","0"],["CPUs","8 cores"],["Memory","16 GB"],["Storage","50 GB"],["Network","No network"],["Working directory","/workspace/vllm"],["Build timeout","180 min"]]},{"title":"Execution","facts":[["Agent Timeout","600 min"],["Agent User","root"],["Agent Network","No network"],["Verifier Timeout","120 min"]]}]}]]}],"$Lb"]}]
