unt":22,"url":"/generated/task-files/vllm-async-pp-token-handoff/environment/7.json"}],"metadataGroups":[{"title":"Task","facts":[["Workload Type","Feature fix"],["Subsystems","Distributed execution, Scheduler, Model runner"]]},{"title":"Compute","facts":[["Accelerator","A100"],["Topology","2"],["GPUs","2"],["GPU types","A100"],["CPUs","8 cores"],["Memory","32 GB"],["Storage","64 GB"],["Os","linux"],["Network","No network"],["Working directory","/workspace/repo"],["Build timeout","3600.0"],["Docker Image","sha256:cf04408e8aed807333ff1522f952182aa7948f2a32e3caeee79dac9b95911e69"]]},{"title":"Execution","facts":[["Agent Timeout","36000.0"],["Agent User","agent"],["Agent Network","No network"],["Verifier Timeout","1800.0"],["Verifier Environment mode","Shared"],["Verifier User","root"]]}]}]]}],"$Lc"]}]
